# ====================================================================
# SkyGlobe — LOCAL setup (.env)
# Copy this file to a new file named exactly  .env  and fill in values.
# ====================================================================

# ---- LOCAL AI ENGINE (Ollama) --------------------------------------
# This makes the academy + CEO AI use your local Ollama (free, no quota).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---- DATABASE (Supabase) -------------------------------------------
# Copy these EXACTLY from your Render dashboard (Environment tab).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SUPABASE-KEY

# ---- LOGIN / SECURITY ----------------------------------------------
# Copy from Render (or set any long random text for SESSION_SECRET).
SESSION_SECRET=any-long-random-text-here
ADMIN_PASSWORD=your-ceo-password

# ---- PORT (local) --------------------------------------------------
PORT=3000

# Note: GEMINI_API_KEY is NOT needed locally while OLLAMA_URL is set.
