# ── SKYGLOBEGROUP — environment template ──────────────────────────────────────
# Copy to .env for local dev, or set these in Render → Environment for
# production. NEVER commit real keys.
#
# (This file previously contained an unrelated Next.js page component by
# mistake — replaced with the actual environment variable list server.js
# reads, generated from `grep -o "process\.env\.[A-Z_]*" server.js`.)

# ── Core / database ────────────────────────────────────────────────────────────
SUPABASE_URL=                                   # https://xxxx.supabase.co
SUPABASE_KEY=                                   # anon/service role key
SESSION_SECRET=                                 # long random string — signs client session tokens
PORT=3000
RENDER_EXTERNAL_URL=                            # set automatically by Render; used to build callback URLs
CANONICAL_HOST=skyglobegroup.com
PUBLIC_ORIGIN=https://skyglobegroup.com

# ── Admin / staff access ───────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORDS=                                # comma-separated, if multiple CEO/admin passwords
STAFF_PASSWORDS=

# ── Payments — one-time services (PRICING catalog) ────────────────────────────
# A provider with no key simply won't appear as a checkout option — nothing
# breaks. See PAYMENTS_SETUP.md for the full setup walkthrough.
PAYSTACK_SECRET_KEY=                            # sk_live_… / sk_test_…
PAYSTACK_PUBLIC_KEY=                            # pk_live_… / pk_test_…
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ── SkyGlobeGroup Membership — weekly/monthly subscription (separate from the
# one-time payments above) ─────────────────────────────────────────────────────
PAYSTACK_PLAN_MEMBERSHIP_WEEKLY=                # PLN_… weekly membership plan code
PAYSTACK_PLAN_MEMBERSHIP_MONTHLY=               # PLN_… monthly membership plan code
PADDLE_API_KEY=                                 # server-side Paddle API key
PADDLE_CLIENT_TOKEN=                            # public token for Paddle.js (safe to expose to the browser)
PADDLE_WEBHOOK_SECRET=                          # Paddle notification destination secret
PADDLE_ENVIRONMENT=sandbox                      # 'sandbox' while testing, 'production' when live
PADDLE_PRICE_MEMBERSHIP_WEEKLY=                 # pri_… weekly membership price id
PADDLE_PRICE_MEMBERSHIP_MONTHLY=                # pri_… monthly membership price id

# ── AI providers ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TTS_VOICE=
GROQ_TTS_VOICE_AR=
CEREBRAS_MODEL=
GEMINI_API_KEY=
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_AUTH=

# ── Voice / TTS ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=
GOOGLE_TTS_API_KEY=

# ── Search ────────────────────────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
UNSPLASH_ACCESS_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
BREVO_API_KEY=
RECIPIENT_EMAIL=
EMAIL_INBOUND_SECRET=
DEPT_EMAILS_LIVE=                               # 'true' once department inboxes are live (see server.js DEPARTMENTS)

# ── Misc ──────────────────────────────────────────────────────────────────────
WORK_TZ_OFFSET=
WORK_START_MIN=
